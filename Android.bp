// Source AudioReach graph services for KleeUI Cupid.
//
// The upstream project still carries Android.mk definitions.  Those modules
// are not addressable from Soong BP namespaces, which prevents the source AGM
// and PAL libraries from linking against them.  Keep the source lists here so
// every runtime library is a real Soong target with explicit ABI/dependency
// metadata.

cc_library_headers {
    name: "libgsl_headers",
    vendor: true,
    export_include_dirs: [
        "gsl/api",
        "gsl/inc",
        "gsl/rtc_api",
        "gsl/hw_rsc_api",
        "gsl/dls_client_api",
    ],
}

cc_library_shared {
    name: "liblx-osal",
    vendor: true,
    compile_multilib: "64",
    cflags: [
        "-D_ANDROID_",
        "-DAR_OSAL_USE_CUTILS",
        "-DPROPERTY_TRIGGER",
        "-Wno-pointer-to-int-cast",
        "-Wno-unused-function",
        "-Wno-unused-label",
    ],
    local_include_dirs: [
        "ar_osal/api",
        "ar_osal/src/linux",
        "ar_osal/src/linux/qcom",
        "ar_osal/src/linux/qcom/dyn_pd",
    ],
    include_dirs: [
        "vendor/qcom/opensource/audio-kernel/include",
    ],
    header_libs: [
        "libarosal_headers",
        "qti_audio_kernel_uapi",
        "libdiag_headers",
    ],
    shared_libs: [
        "liblog",
        "libdiag",
        "libion",
        "libcutils",
    ],
    srcs: [
        "ar_osal/src/linux/ar_osal_mutex.c",
        "ar_osal/src/linux/ar_osal_thread.c",
        "ar_osal/src/linux/ar_osal_signal.c",
        "ar_osal/src/linux/ar_osal_log.c",
        "ar_osal/src/linux/ar_osal_file_io.c",
        "ar_osal/src/linux/ar_osal_sleep.c",
        "ar_osal/src/linux/ar_osal_mem_op.c",
        "ar_osal/src/linux/ar_osal_heap.c",
        "ar_osal/src/linux/ar_osal_timer.c",
        "ar_osal/src/linux/ar_osal_string.c",
        "ar_osal/src/linux/qcom/ar_osal_log_pkt_op.c",
        "ar_osal/src/linux/qcom/ar_osal_servreg.c",
        "ar_osal/src/linux/qcom/dyn_pd/ar_osal_dyn_pd.c",
        // Cupid's Taro 5.10 kernel uses the dma-buf/ION bridge implementation.
        "ar_osal/src/linux/qcom/ar_osal_shmem_db.c",
        "ar_osal/src/linux/qcom/ar_osal_shmem.c",
        "ar_osal/src/linux/qcom/ar_osal_shmem_ap.c",
    ],
    export_include_dirs: ["ar_osal/api"],
}

cc_library_shared {
    name: "libar-acdb",
    vendor: true,
    compile_multilib: "64",
    cflags: ["-D_ANDROID_"],
    local_include_dirs: [
        "acdb/api",
        "acdb/inc",
        "ar_osal/api",
    ],
    header_libs: [
        "libcutils_headers",
        "libutils_headers",
        "libacdb_headers",
        "libarosal_headers",
        "libdiag_headers",
    ],
    shared_libs: ["liblx-osal"],
    srcs: [
        "acdb/src/acdb.c",
        "acdb/src/acdb_command.c",
        "acdb/src/acdb_delta_file_mgr.c",
        "acdb/src/acdb_delta_parser.c",
        "acdb/src/acdb_file_mgr.c",
        "acdb/src/acdb_init.c",
        "acdb/src/acdb_init_utility.c",
        "acdb/src/acdb_parser.c",
        "acdb/src/acdb_utility.c",
        "acdb/src/acdb_data_proc.c",
        "acdb/src/acdb_heap.c",
        "acdb/src/acdb_context_mgr.c",
    ],
    export_include_dirs: [
        "acdb/api",
        "acdb/inc",
    ],
}

cc_library_shared {
    name: "liblx-ar_util",
    vendor: true,
    compile_multilib: "64",
    cflags: ["-D_ANDROID_"],
    local_include_dirs: [
        "ar_util/api",
        "ar_util/inc",
    ],
    header_libs: [
        "libspf-headers",
        "libarosal_headers",
    ],
    shared_libs: [
        "liblog",
        "liblx-osal",
    ],
    srcs: [
        "ar_util/src/ar_util_list.c",
        "ar_util/src/ar_util_data_log.c",
        "ar_util/src/ar_util_err_detection.c",
    ],
    export_include_dirs: ["ar_util/api"],
}

cc_library_shared {
    name: "libar-gpr",
    vendor: true,
    compile_multilib: "64",
    cflags: [
        "-D_ANDROID_",
        "-DSESSION_ARRAY_SIZE=200",
        "-DGPR_USE_CUTILS",
    ],
    local_include_dirs: [
        "gpr/ext/logging/inc",
        "gpr/api",
        "gpr/api/private",
        "gpr/core/inc",
        "gpr/core/inc/ar_utils/generic",
        "gpr/core/src",
        "gpr/ext/dynamic_allocation/inc",
        "gpr/ext/logging/inc",
        "gpr/datalinks/gpr_lx/inc",
        "ar_osal/api",
    ],
    header_libs: ["libarosal_headers"],
    shared_libs: [
        "liblx-osal",
        "libcutils",
        "liblog",
    ],
    srcs: [
        "gpr/core/src/gpr_drv.c",
        "gpr/core/src/gpr_list.c",
        "gpr/core/src/gpr_main.c",
        "gpr/core/src/gpr_memq.c",
        "gpr/core/src/gpr_drv_island.c",
        "gpr/core/src/gpr_list_island.c",
        "gpr/core/src/gpr_memq_island.c",
        "gpr/core/src/hash_based/gpr_session.c",
        "gpr/core/src/hash_based/gpr_session_island.c",
        "gpr/ext/dynamic_allocation/src/gpr_dynamic_allocation.c",
        "gpr/ext/logging/src/gpr_log_generic.c",
        "gpr/ext/logging/stub_src/gpr_log_diag_stub.c",
        "gpr/datalinks/gpr_lx/src/gpr_lx.c",
        "gpr/platform/linux/gpr_init_lx_wrapper.c",
    ],
    export_include_dirs: ["gpr/api"],
}

cc_library_shared {
    name: "libar-gsl",
    vendor: true,
    compile_multilib: "64",
    cflags: [
        "-D_ANDROID_",
        "-DGSL_DEBUG_ENABLE",
        "-DGSL_EXT_MEM_CACHE_DISABLE",
        "-DGSL_LOG_PKT_ENABLE",
        "-DGSL_PKT_LOG_PATH=\"/data/vendor/audio/gsl_log.bin\"",
        "-Wno-gnu-designator",
        "-Wno-shorten-64-to-32",
        "-Wno-sign-compare",
        "-Wno-tautological-compare",
        "-Wno-typedef-redefinition",
        "-Wno-unused-function",
        "-Wno-unused-label",
        "-Wno-unused-local-typedef",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
    ],
    local_include_dirs: [
        "gsl/api",
        "gsl/inc",
        "gsl/rtc_api",
        "gsl/hw_rsc_api",
        "gsl/dls_client_api",
    ],
    header_libs: [
        "libspf-headers",
        "libarosal_headers",
        "libacdb_headers",
    ],
    shared_libs: [
        "liblx-osal",
        "libar-acdb",
        "liblx-ar_util",
        "libar-gpr",
        "libcutils",
    ],
    srcs: [
        "gsl/src/gsl_main.c",
        "gsl/src/gsl_graph.c",
        "gsl/src/gsl_shmem_mgr.c",
        "gsl/src/gsl_subgraph.c",
        "gsl/src/gsl_subgraph_pool.c",
        "gsl/src/gsl_common.c",
        "gsl/src/gsl_spf_ss_state.c",
        "gsl/src/gsl_hw_rsc_mgr.c",
        "gsl/src/gsl_rtc.c",
        "gsl/src/gsl_rtc_main.c",
        "gsl/src/gsl_dynamic_module_mgr.c",
        "gsl/src/gsl_mdf_utils.c",
        "gsl/src/gsl_spf_timeout.c",
        "gsl/src/gsl_datapath.c",
        "gsl/src/gsl_msg_builder.c",
        "gsl/src/gsl_global_persist_cal.c",
        "gsl/src/gsl_dls_client.c",
        "gsl/src/gsl_cshm_mgr.c",
    ],
    export_include_dirs: [
        "gsl/api",
        "gsl/rtc_api",
        "gsl/hw_rsc_api",
        "gsl/dls_client_api",
    ],
}

cc_library_shared {
    name: "libats",
    vendor: true,
    compile_multilib: "64",
    cflags: [
        "-D_ANDROID_",
        "-DAR_ATS_USE_CUTILS",
        // Cupid's proprietary libmcs is ABI-locked to the stock AudioReach
        // closure. Keep the open ATS implementation source-built, but leave
        // the optional MCS adapter disabled until a matching source backend
        // exists; otherwise ATS dlopen()s an incompatible libmcs.so.
    ],
    local_include_dirs: [
        "acdb/ats/inc",
        "acdb/ats/rtc/common/inc",
        "acdb/ats/online/common/inc",
        "acdb/ats/mcs/common/inc",
        "acdb/ats/mcs/common/api",
        "acdb/ats/fts/common/inc",
        "acdb/ats/transports/diag/linux/actp/inc",
        "acdb/ats/transports/diag/linux/audtp/inc",
        "acdb/ats/transports/diag/linux/inc",
        "acdb/ats/adie/common/inc",
        "acdb/ats/adie/common/api",
        "acdb/ats/api",
        "acdb/ats/sockets/common/api",
        "acdb/ats/transports/common/api",
        "acdb/ats/transports/tcpip_server/inc",
        "acdb/ats/transports/tcpip_server/api",
        "acdb/ats/dls/common/inc",
        "acdb/api",
        "acdb/inc",
        "gsl/api",
        "gsl/rtc_api",
        "gsl/dls_client_api",
        "ar_osal/api",
    ],
    header_libs: [
        "libats_headers",
        "libacdb_headers",
        "libarosal_headers",
        "libgsl_headers",
        "libspf-headers",
        "libdiag_headers",
    ],
    shared_libs: [
        "liblx-osal",
        "libutils",
        "libcutils",
        "libdiag",
        "libar-gsl",
        "libar-acdb",
    ],
    srcs: [
        "acdb/ats/src/ats.c",
        "acdb/ats/src/ats_command.c",
        "acdb/ats/rtc/common/src/ats_rtc.c",
        "acdb/ats/online/common/src/ats_online.c",
        "acdb/ats/mcs/common/src/ats_mcs.c",
        "acdb/ats/mcs/linux/mcs.c",
        "acdb/ats/fts/common/src/ats_fts.c",
        "acdb/ats/transports/diag/linux/actp/src/actp.c",
        "acdb/ats/transports/diag/linux/audtp/src/audtp.c",
        "acdb/ats/adie/common/src/ats_adie_rtc.c",
        "acdb/ats/adie/linux/adie_rtc.c",
        "acdb/ats/sockets/linux/src/ar_sockets.cpp",
        "acdb/ats/transports/common/src/ats_transport.c",
        "acdb/ats/transports/tcpip_server/src/tcpip_cmd_server.cpp",
        "acdb/ats/transports/tcpip_server/src/tcpip_dls_server.cpp",
        "acdb/ats/transports/tcpip_server/src/tcpip_socket_util.cpp",
        "acdb/ats/dls/common/src/ats_dls.c",
    ],
    export_include_dirs: [
        "acdb/ats/api",
        "acdb/ats/inc",
        "acdb/ats/adie/common/api",
        "acdb/ats/mcs/common/api",
    ],
}
